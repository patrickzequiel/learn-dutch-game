  "grammar": [
    {
      "id": "g-tijden-verslag",
      "title": "Perfectum / Imperfectum / Praesens in een verslag",
      "explanation": "Bij het schrijven van een verslag gebruik je drie verschillende tijden voor drie verschillende situaties.",
      "rule": "Perfectum = losse activiteiten | Imperfectum = emotie, extra info, gewoontes | Praesens = algemene informatie",
      "examples": [
        {
          "dutch": "We zijn naar Dinant gegaan.",
          "translation": "We went to Dinant.",
          "highlight": "Perfectum: losse activiteit"
        },
        {
          "dutch": "Het was echt de moeite.",
          "translation": "It was really worth it.",
          "highlight": "Imperfectum: jouw emotie"
        },
        {
          "dutch": "De stad ligt aan de rivier de Maas.",
          "translation": "The city is along the Meuse river.",
          "highlight": "Praesens: algemene info"
        }
      ],
      "lessonId": "les2",
      "category": "tense"
    },
    {
      "id": "g-perfectum-zijn",
      "title": "Perfectum met hebben of zijn?",
      "explanation": "Sommige verba vormen het perfectum met 'zijn' in plaats van 'hebben'.",
      "rule": "Zijn: bewegingsverba (gaan, komen, rijden...) + toestandsverandering (worden, groeien...) | Hebben: de rest",
      "examples": [
        {
          "dutch": "We zijn naar Dinant gegaan.",
          "translation": "We went to Dinant.",
          "highlight": "zijn + gegaan"
        },
        {
          "dutch": "Hij is verhuisd naar Brussel.",
          "translation": "He moved to Brussels.",
          "highlight": "zijn + verhuisd"
        },
        {
          "dutch": "We hebben de kerk bezocht.",
          "translation": "We visited the church.",
          "highlight": "hebben + bezocht"
        },
        {
          "dutch": "Ze hebben gegeten in een restaurant.",
          "translation": "They ate in a restaurant.",
          "highlight": "hebben + gegeten"
        }
      ],
      "lessonId": "les2",
      "category": "tense"
    },
    {
      "id": "g-adjectief-flexie",
      "title": "Flexie van het adjectief",
      "explanation": "Adjectieven krijgen een -e BEHALVE bij 'een' + het-woord.",
      "rule": "Altijd +e: de mooie stad, een mooie stad, het mooie land | GEEN -e: een mooi land (een + het-woord)",
      "examples": [
        {
          "dutch": "de mooie stad",
          "translation": "the nice city",
          "highlight": "+e: de-woord"
        },
        {
          "dutch": "een mooie stad",
          "translation": "a nice city",
          "highlight": "+e: de-woord met een"
        },
        {
          "dutch": "het mooie land",
          "translation": "the nice country",
          "highlight": "+e: het-woord met het"
        },
        {
          "dutch": "een mooi land",
          "translation": "a nice country",
          "highlight": "GEEN -e: een + het-woord"
        }
      ],
      "lessonId": "les2",
      "category": "grammar"
    },
    {
      "id": "g-spelling",
      "title": "Spellingregels",
      "explanation": "In het Nederlands gelden duidelijke regels voor de spelling van klanken.",
      "rule": "1 syllabe: korte klank=1 vocaal (tas), lange klank=2 vocalen (gaan) | Meer syllaben: korte klank=1V+2C (letter), lange klank=1V+1C (tafel)",
      "examples": [
        {
          "dutch": "tas, bank (korte klank, 1 syllabe)",
          "translation": "bag, bench → 1 vowel",
          "highlight": "korte klank"
        },
        {
          "dutch": "gaan, boom (lange klank, 1 syllabe)",
          "translation": "go, tree → 2 vowels",
          "highlight": "lange klank"
        },
        {
          "dutch": "let-ter (korte klank, 2 syllaben)",
          "translation": "letter → 1 vowel + 2 consonants",
          "highlight": "korte klank"
        },
        {
          "dutch": "ta-fel (lange klank, 2 syllaben)",
          "translation": "table → 1 vowel + 1 consonant",
          "highlight": "lange klank"
        }
      ],
      "lessonId": "les2",
      "category": "spelling"
    }
  ],
  "exercises": [
    {
      "id": "e2-mc1",
      "type": "multiple-choice",
      "question": "We ___ naar Dinant ___ (gaan). Welke vorm is correct?",
      "options": [
        "hebben ... gegaan",
        "zijn ... gegaan",
        "zijn ... gaan",
        "hebben ... gaan"
      ],
      "answer": "zijn ... gegaan",
      "explanation": "'Gaan' is een bewegingswerkwoord. Perfectum = zijn + gegaan.",
      "lessonId": "les2"
    },
    {
      "id": "e2-mc2",
      "type": "multiple-choice",
      "question": "Het ___ (zijn) echt de moeite. Welke tijd gebruik je hier?",
      "options": [
        "is (presens)",
        "was (imperfectum)",
        "is geweest (perfectum)",
        "had geweest (plusquamperfectum)"
      ],
      "answer": "was (imperfectum)",
      "explanation": "Jouw emotie/appreciatie = imperfectum: 'Het was echt de moeite.'",
      "lessonId": "les2"
    },
    {
      "id": "e2-mc3",
      "type": "multiple-choice",
      "question": "Welke zin is correct?",
      "options": [
        "een mooi land",
        "een mooie land",
        "de mooi stad",
        "een mooi stad"
      ],
      "answer": "een mooi land",
      "explanation": "'Land' is een het-woord. Na 'een' + het-woord: geen -e → een mooi land.",
      "lessonId": "les2"
    },
