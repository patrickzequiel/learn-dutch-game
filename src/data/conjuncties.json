  "grammar": [
    {
      "id": "g-conjunctie-zin",
      "title": "Zinsconstructie met een conjunctie",
      "explanation": "Een conjunctie leidt een bijzin in. In de bijzin staat het werkwoord ACHTERAAN (S + R + V1 + V2).",
      "rule": "Bijzin: Subject + Rest + Verbum1 + Verbum2 | Conjunctie kan aan het begin of midden staan | Bijzin eerst → komma → hoofdzin",
      "examples": [
        {
          "dutch": "Ik ga niet mee omdat ik geen zin heb.",
          "translation": "No voy porque no tengo ganas.",
          "highlight": "heb (V1 achteraan)"
        },
        {
          "dutch": "Omdat ik geen zin heb, ga ik niet mee.",
          "translation": "Como no tengo ganas, no voy.",
          "highlight": "Bijzin eerst → komma → hoofdzin"
        },
        {
          "dutch": "Nadat hij gegeten had, ging hij naar huis.",
          "translation": "Después de comer, fue a casa.",
          "highlight": "nadat + plusquamperfectum"
        }
      ],
      "lessonId": "conjuncties",
      "category": "conjunctie"
    }
  ],
