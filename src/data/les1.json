  "grammar": [
    {
      "id": "g-er-subject",
      "title": "'Er' als subject",
      "explanation": "In het Nederlands begin je een zin NIET met een niet-specifiek subject. Gebruik 'er' als het subject niet specifiek is.",
      "rule": "Niet-specifiek subject = een cijfer, veel/weinig/genoeg, artikel 'een', geen artikel → gebruik 'Er' aan het begin",
      "examples": [
        {
          "dutch": "Er zitten 6 cursisten in de klas.",
          "translation": "Hay 6 estudiantes en la clase.",
          "highlight": "Er"
        },
        {
          "dutch": "Er ligt een boek op de tafel.",
          "translation": "Hay un libro en la mesa.",
          "highlight": "Er"
        },
        {
          "dutch": "Er staan stoelen in de klas.",
          "translation": "Hay sillas en la clase.",
          "highlight": "Er"
        },
        {
          "dutch": "Er hangt een projector aan het plafond.",
          "translation": "Hay un proyector en el techo.",
          "highlight": "Er"
        }
      ],
      "lessonId": "les1",
      "category": "grammar"
    }
  ],
  "exercises": [
    {
      "id": "e1-mc1",
      "type": "multiple-choice",
      "question": "Welk woord betekent \"traag wandelen terwijl je geniet van de stad\"?",
      "options": [
        "verdwalen",
        "slenteren",
        "ontdekken",
        "bewonderen"
      ],
      "answer": "slenteren",
      "explanation": "Slenteren = traag wandelen terwijl je geniet van je omgeving.",
      "lessonId": "les1"
    },
